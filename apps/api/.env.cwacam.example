# CWACAM API — isolated local MySQL (never point this at BeyondTechWorld)
PORT=3005
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_CWACAM_JWT_SECRET

# Docker service cwacam-mysql (docker compose up -d cwacam-mysql)
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=cwacam
DB_PASSWORD=cwacam_local
DB_NAME=cwacam

COMPANY_NAME="Catholic Women's Association Cameroon"

SEED_ADMIN_EMAIL=admin@cwacam.org
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe@123456
SEED_ADMIN_PHONE=+237675321739
SEED_ADMIN_NAME=Administrator

WASENDER_API_KEY=
WASENDER_BASE_URL=https://wasenderapi.com/api
WASENDER_DEFAULT_COUNTRY=CM
WASENDER_MIN_SEND_INTERVAL_MS=6000
WASENDER_TEXT_TO_DOCUMENT_DELAY_MS=6000

UPLOAD_DIR=./uploads
